---
# Template for Kubernetes Secrets
# IMPORTANT: In production, use SealedSecrets or an external secrets operator.
# Do NOT commit actual secrets to git.
#
# To use this template:
# 1. Copy this file: cp k8s/secrets.yaml.template k8s/secrets.yaml (in .gitignore)
# 2. Replace placeholder values with actual secrets
# 3. For production: use sealed-secrets or HashiCorp Vault
#
# Instructions for SealedSecrets:
# - Install: kubectl apply -f https://github.com/bitnami-labs/sealed-secrets/releases/download/v0.18.0/controller.yaml
# - Seal a secret: echo -n 'password' | kubectl create secret generic db-secret --dry-run=client --from-file=password=/dev/stdin -o yaml | kubeseal > secrets.yaml

apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: galaxy
type: Opaque
stringData:
  password: "CHANGE-ME-postgres-password-12345"
  url: "postgresql://postgres:CHANGE-ME-postgres-password-12345@postgres:5432/galaxy"

---
apiVersion: v1
kind: Secret
metadata:
  name: api-keys
  namespace: galaxy
type: Opaque
stringData:
  # Edge planet API key (for device authentication)
  EDGE_TENANT_API_KEY: "gal_CHANGE-ME-edge-key-12345"
  EDGE_DEVICE_ID: "planet-default-001"
  
  # Webhook service API key (for tenant authentication)
  WEBHOOK_TENANT_SECRET: "CHANGE-ME-webhook-secret-12345"
  
  # Compliance engine encryption key
  COMPLIANCE_ENCRYPTION_KEY: "CHANGE-ME-compliance-key-32bytes-min"
  
  # Predictive service telemetry key (if using external service)
  OPENWEATHER_API_KEY: "CHANGE-ME-openweather-api-key"

---
apiVersion: v1
kind: Secret
metadata:
  name: tls-certificates
  namespace: galaxy
type: kubernetes.io/tls
stringData:
  # mTLS certificates for swarm and internal communication
  # Generated by: bash infra/certs/generate-dev-certs.sh
  
  # CA certificate
  ca.crt: |
    -----BEGIN CERTIFICATE-----
    CHANGE-ME-CA-CERTIFICATE-CONTENT
    -----END CERTIFICATE-----
  
  # Swarm node certificate
  swarm-node.crt: |
    -----BEGIN CERTIFICATE-----
    CHANGE-ME-SWARM-NODE-CERTIFICATE
    -----END CERTIFICATE-----
  
  # Swarm node key
  swarm-node.key: |
    -----BEGIN PRIVATE KEY-----
    CHANGE-ME-SWARM-NODE-KEY
    -----END PRIVATE KEY-----
  
  # Edge planet certificate
  edge-planet.crt: |
    -----BEGIN CERTIFICATE-----
    CHANGE-ME-EDGE-PLANET-CERTIFICATE
    -----END CERTIFICATE-----
  
  # Edge planet key
  edge-planet.key: |
    -----BEGIN PRIVATE KEY-----
    CHANGE-ME-EDGE-PLANET-KEY
    -----END PRIVATE KEY-----

---
# IMPORTANT: In production environments, do NOT use plain Secrets.
# Instead:
#
# Option 1: Use SealedSecrets (https://github.com/bitnami-labs/sealed-secrets)
#   kubectl apply -f https://github.com/bitnami-labs/sealed-secrets/releases/download/v0.18.0/controller.yaml -n kube-system
#   Then seal your secrets:
#     kubeseal -f secrets.yaml -w sealed-secrets.yaml
#
# Option 2: Use HashiCorp Vault with External Secrets Operator
#   helm install external-secrets external-secrets/external-secrets -n external-secrets-system --create-namespace
#   Create ExternalSecret resources pointing to Vault
#
# Option 3: Use your cloud provider's secrets manager
#   AWS Secrets Manager, Azure Key Vault, GCP Secret Manager, etc.
#   Use a secrets injection sidecar or controller
#
# Always follow principle of least privilege and rotate secrets regularly.
