# Local Paperclip environment variables
# Copy to .paperclip/.env locally and load before starting Paperclip.

# GitHub Personal Access Token (classic) with: repo, workflow
GITHUB_TOKEN=ghp_replace_me

# Optional explicit repository defaults used by custom scripts/skills
GITHUB_REPOSITORY=honeyamn10-source/galaxy_mvp
GITHUB_OWNER=honeyamn10-source
