# Galaxy MVP runtime configuration example
# Copy to .env and edit values for your environment.

# Required for edge ingestion auth
EDGE_TENANT_API_KEY=<generate-with-openssl-rand-hex-32>

# Optional: connect real camera stream. Leave empty to use simulated events.
RTSP_URL=
CAMERA_POLL_INTERVAL_SECONDS=1.5
CAMERA_MIN_CONFIDENCE=0.75
EDGE_EVENT_TYPES=fire,smoke,intrusion,motion,fall_detection,weapon_detection,gun_detection

# Optional: mount your own model file under ./models and point to container path.
# Compose mounts ./models -> /models (read-only).
MODEL_PATH=/models/default-model.json

# Optional compliance region profile (eu/us/apac)
COMPLIANCE_DEFAULT_REGION=eu

# Optional LLM and weather settings
OPENWEATHER_API_KEY=
LLM_PROVIDER=auto
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OPENROUTER_API_KEYS=
OPENROUTER_MODEL=openai/gpt-3.5-turbo

# Auth and OTP delivery
ENVIRONMENT=production
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
OTP_TTL_MINUTES=10

# Phase 1 enterprise auth defaults
JWT_SECRET=<generate-with-openssl-rand-hex-32>
INTERNAL_API_KEY=<generate-with-openssl-rand-hex-32>
AUTH_SERVICE_URL=http://localhost:8700
DEFAULT_EDGE_API_KEY=<generate-with-openssl-rand-hex-32>
DEFAULT_EDGE_ORG_NAME=Edge Demo

# Required data and compliance secrets
POSTGRES_USER=galaxy
POSTGRES_PASSWORD=<generate-with-openssl-rand-base64-32>
POSTGRES_DB=galaxy
COMPLIANCE_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>

# Cloudflare Worker protection
ALLOWED_ORIGINS=https://your-dashboard.example.com
AI_API_KEY=<generate-with-openssl-rand-hex-32>
