# Galaxy MVP runtime configuration example
# Copy to .env and edit values for your environment.

# Required for edge ingestion auth
EDGE_TENANT_API_KEY=edge-planet-local

# Optional: connect real camera stream. Leave empty to use simulated events.
RTSP_URL=

# Optional: mount your own model file under ./models and point to container path.
# Compose mounts ./models -> /models (read-only).
MODEL_PATH=/models/default-model.json

# Optional compliance region profile (eu/us/apac)
COMPLIANCE_DEFAULT_REGION=eu

# Optional LLM and weather settings
OPENWEATHER_API_KEY=
OPENROUTER_API_KEYS=
OPENROUTER_MODEL=openai/gpt-3.5-turbo

# Phase 1 enterprise auth defaults
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
INTERNAL_API_KEY=change-me-internal-service-key
AUTH_SERVICE_URL=http://localhost:8700
DEFAULT_ADMIN_EMAIL=admin@test.com
DEFAULT_ADMIN_PASSWORD=Test1234!
DEFAULT_ADMIN_ORG_NAME=Test Corp
DEFAULT_EDGE_API_KEY=edge-planet-local
DEFAULT_EDGE_ORG_NAME=Edge Demo
